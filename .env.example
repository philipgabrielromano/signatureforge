# ── Database ──────────────────────────────────────────────────────────
# Render Managed Postgres provides these automatically via render.yaml
DATABASE_URL="postgresql://signatureforge:password@localhost:5432/signatureforge"
DIRECT_URL="postgresql://signatureforge:password@localhost:5432/signatureforge"
# (In Render, DIRECT_URL = same connection string but bypasses PgBouncer for migrations)

# ── NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:43123"
NEXTAUTH_SECRET="generate-32-char-random-string"
AUTH_SECRET="generate-32-char-random-string"
# Set AUTH_DEMO_MODE=true to sign in without Azure AD (local / first boot)
AUTH_DEMO_MODE="true"

# ── Azure AD (admin login to SignatureForge UI) ───────────────────────
AZURE_AD_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_AD_CLIENT_SECRET="your-client-secret"
AZURE_AD_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Redirect URI to register in Azure AD:
# https://your-app.onrender.com/api/auth/callback/azure-ad
# http://localhost:43123/api/auth/callback/azure-ad

# ── Microsoft 365 Graph API (signature injection) ─────────────────────
MS365_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MS365_CLIENT_SECRET="your-m365-app-secret"
MS365_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ── Azure Blob Storage (image storage) ────────────────────────────────
# Same Azure subscription you already use for M365 / Graph API
AZURE_STORAGE_ACCOUNT_NAME="signatureforgestorage"
AZURE_STORAGE_ACCOUNT_KEY="your-storage-account-key-1"
AZURE_STORAGE_CONTAINER_NAME="signature-images"
AZURE_STORAGE_PUBLIC_URL="https://signatureforgestorage.blob.core.windows.net/signature-images"
# If using Azure CDN, set this to your CDN endpoint instead:
# AZURE_STORAGE_PUBLIC_URL="https://signatureforge.azureedge.net/signature-images"
# Note: Container must have "Blob" public access level (not private)

# ── Cron ─────────────────────────────────────────────────────────────
CRON_SECRET="generate-another-random-string"
# Render auto-generates this and shares it to the cron container

# ── App ───────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:43123"
